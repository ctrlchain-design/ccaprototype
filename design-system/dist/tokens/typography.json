{
  "$comment": "Type utilities from shared/styles/tailwind/tailwind.css. Roboto is the only family.",
  "fontFamily": "Roboto",
  "weights": [
    300,
    400,
    500,
    700
  ],
  "styles": [
    {
      "class": "text-2xs",
      "font-size": "0.625rem"
    },
    {
      "class": "text-cca-base-sm",
      "font-size": "0.875rem",
      "line-height": "1.25rem",
      "font-weight": "400"
    },
    {
      "class": "text-cca-base",
      "font-size": "1rem",
      "line-height": "1.5rem",
      "font-weight": "400"
    },
    {
      "class": "text-cca-label-2xs",
      "font-size": "0.5rem",
      "line-height": "0.625rem",
      "font-weight": "400"
    },
    {
      "class": "text-cca-label-xs",
      "font-size": "0.625rem",
      "line-height": "0.625rem",
      "font-weight": "400"
    },
    {
      "class": "text-cca-label-sm",
      "font-size": "0.75rem",
