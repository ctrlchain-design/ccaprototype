    {
      "class": "text-cca-tab",
      "font-size": "1rem",
      "line-height": "1.5rem",
      "font-weight": "500",
      "text-transform": "uppercase"
    },
    {
      "class": "text-cca-link",
      "font-size": "1rem",
      "line-height": "1.5rem",
      "font-weight": "500",
      "text-decoration-line": "underline"
    },
    {
      "class": "text-cca-n-badge",
      "font-size": "0.75rem",
      "line-height": "1rem",
      "font-weight": "500"
    },
    {
      "class": "text-cca-counter",
      "font-size": "2rem",
      "line-height": "2.25rem",
      "font-weight": "700"
